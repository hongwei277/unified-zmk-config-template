#include <dt-bindings/zmk/hid_usage.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/gamepad.h>

/ {
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
                &gp 0  // A
                &gp 1  // B
                &gp 2  // Select
                &gp 3  // Start
                &gp 4  // Up
                &gp 5  // Down
                &gp 6  // Left
                &gp 7  // Right
            >;
        };
    };
};
